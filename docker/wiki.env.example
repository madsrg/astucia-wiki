# =============================================================================
# Astucia Wiki — container environment
# =============================================================================
#
#   cp docker/wiki.env.example docker/wiki.env
#   $EDITOR docker/wiki.env
#   docker run -d --name astucia-wiki -p 8080:80 \
#       -v wiki-data:/data --env-file docker/wiki.env astucia-wiki:latest
#
# Or from Compose, replacing the inline `environment:` block:
#
#   services:
#     wiki:
#       env_file: docker/wiki.env
#
# Every value below is optional — the defaults produce a working wiki. Uncommented
# lines are the ones worth reviewing before a real deployment.
#
# -----------------------------------------------------------------------------
# HOW DOCKER PARSES THIS FILE — it is NOT a shell script
# -----------------------------------------------------------------------------
#   * Do NOT quote values.  APP_TITLE="My Wiki"  sets the title to  "My Wiki"
#     including the quote characters. Write:  APP_TITLE=My Wiki
#   * No inline comments. Everything after the first "=" is the value, so
#     SESSION_TIMEOUT=3600   # one hour     becomes  "3600   # one hour"
#   * No variable expansion. $OTHER_VAR is passed through literally.
#   * A bare name with no "=" (e.g. just  TZ ) copies that variable's value from
#     the host environment.
#   * Lines starting with # and blank lines are ignored.
#
# This file may end up holding mail credentials, so it is git-ignored. AI provider
# API keys are NOT set here — they are entered per AI user in Admin → AI and stored
# in /data/system/users.json.
# =============================================================================


# -----------------------------------------------------------------------------
# Identity and locale
# -----------------------------------------------------------------------------

# Shown in the UI header and used as the default sender name for email.
APP_TITLE=Astucia Wiki

# 'production' or 'development'. Affects verbosity of logging only.
ENVIRONMENT=production

# IANA zone name, e.g. Europe/Copenhagen, America/New_York, UTC.
# Set this. It drives the system clock, PHP's date functions AND cron, so leaving
# it at UTC means scheduled AI jobs and the daily digest fire at the wrong hour.
TZ=UTC

# Public URL of the wiki, without a trailing slash. Needed behind a reverse proxy
# so login redirects and share links point at the right host.
#APP_BASE_URL=https://wiki.example.com


# -----------------------------------------------------------------------------
# Storage — paths INSIDE the container
# -----------------------------------------------------------------------------
# Change these only if you mount the volume somewhere other than /data. All three
# must end in a slash; the entrypoint adds one if you forget.
#
#   PAGES_DIR         your content
#   WIKI_SYSTEM_DATA  users.json, AI job queue, search.sqlite — never web-reachable
#   LOG_DIR           nginx, PHP and cron logs

PAGES_DIR=/data/pages/
WIKI_SYSTEM_DATA=/data/system/
LOG_DIR=/data/logs/


# -----------------------------------------------------------------------------
# File ownership (bind mounts only)
# -----------------------------------------------------------------------------
# Leave these unset unless you have a reason. When they are unset and you bind-mount
# a host directory, the container adopts that directory's owner so your files stay
# yours. Setting them overrides that.
#   $ id -u    # -> PUID
#   $ id -g    # -> PGID
#PUID=1000
#PGID=1000


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# off   — no login. Anyone who can reach the port has full admin rights.
#         Fine on a private network; never expose it to the internet.
# otp   — one-time codes by email (requires the mail settings below).
# oidc  — your identity provider (requires the OIDC settings below).
# both  — users may choose either.
AUTHENTICATION=off

# When auth is on, allow unauthenticated visitors to read (but not edit).
ANONYMOUS_ACCESS_ENABLED=false

# Idle session timeout, in seconds.
SESSION_TIMEOUT=3600

# --- OIDC (only for AUTHENTICATION=oidc or both) ---
#OIDC_PROVIDER_URL=https://accounts.google.com
#OIDC_CLIENT_ID=your-client-id
#OIDC_CLIENT_SECRET=your-client-secret
#OIDC_REDIRECT_URI=https://wiki.example.com/auth.php


# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
# 'sqlite' builds an FTS5 full-text index at WIKI_SYSTEM_DATA/search.sqlite.
# Anything else falls back to a slower scan of the files.
# Note: full-text search covers pages inside Spaces. Pages sitting directly in
# PAGES_DIR are browsable and editable but are not returned by search.
SEARCH_ENGINE=sqlite


# -----------------------------------------------------------------------------
# Detecting content changed outside the wiki
# -----------------------------------------------------------------------------
# Minimum seconds between filesystem scans. Files that arrive by rsync, git pull or
# a host editor are reconciled with the index, the knowledge graph and search, and
# the open page reloads itself. Lower reacts sooner; raise it on a very large
# content directory. No cron or filesystem watcher is involved.
INDEX_SYNC_INTERVAL_SECONDS=30


# -----------------------------------------------------------------------------
# Scheduled work (cron inside the container)
# -----------------------------------------------------------------------------
# false disables cron entirely: scheduled AI agent jobs never fire and one-off
# /aiJob requests are accepted but never start. Use it if you run the scripts from
# the host instead.
ENABLE_CRON=true

# How often the agent-job runner ticks, in minutes (1–59). The wiki derives the
# "your job starts in about N minutes" estimate from this same value, so the
# crontab and the app cannot disagree.
AGENT_JOB_RUNNER_INTERVAL_MINUTES=15

# Hour (0–23, local time per TZ) at which the opt-in daily digest email is sent.
DAILY_DIGEST_HOUR=7


# -----------------------------------------------------------------------------
# Email — optional
# -----------------------------------------------------------------------------
# Needed only for: OTP login, page sharing, the daily digest, and agent-job failure
# alerts. Nothing is sent until a provider is configured.

# Recipient of agent-job failure alerts and admin notifications.
#ADMIN_EMAIL=you@example.com

# 'sendgrid' or 'mailgun'. If omitted, whichever provider has an API key set is used.
#MAIL_PROVIDER=sendgrid

#SENDGRID_API_KEY=SG.xxxxxxxx
#SENDGRID_FROM_EMAIL=wiki@example.com
#SENDGRID_FROM_NAME=Astucia Wiki

#MAILGUN_API_KEY=key-xxxxxxxx
#MAILGUN_DOMAIN=mg.example.com
# 'us' (default) or 'eu' — must match where the Mailgun domain is hosted.
#MAILGUN_REGION=us
#MAILGUN_FROM_EMAIL=wiki@example.com
#MAILGUN_FROM_NAME=Astucia Wiki


# -----------------------------------------------------------------------------
# Git version history — optional
# -----------------------------------------------------------------------------
# Only used when PAGES_DIR is a git repository. Commits are attributed to the
# editing user; these are the fallback identity git requires to commit at all.
#GIT_AUTHOR_NAME=Astucia Wiki
#GIT_AUTHOR_EMAIL=wiki@localhost


# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------
# Appends the HTTP status and a truncated response body to errors from a model
# endpoint. Useful when a reverse proxy in front of a self-hosted model returns an
# HTML error page instead of JSON. Leave off in normal operation.
AI_DEBUG_RAW_ERRORS=false

# Log paths shown in Admin → Diagnostics. Defaults point inside LOG_DIR, so they
# are visible both in the volume and via `docker logs`.
#NGINX_ACCESS_LOG=/data/logs/nginx-access.log
#NGINX_ERROR_LOG=/data/logs/nginx-error.log
